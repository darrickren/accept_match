# AcceptMatch backend settings (placeholders only; never put a real key in this file).
# Copy to .env (gitignored) or export in your shell. Values in <...> are ignored until you replace them.
# Simplest for a Gemini key: python -m backend.scripts.dev gemini-key
# (hidden prompt, stored in .local/, mode 600). Live providers are optional and are not needed for the demo.

# Which backend agent answers: mock | gemini-local | bedrock-local | agentcore
APP_MODE=mock

# Google Gemini API (server-side only: the Streamlit site never receives it)
GEMINI_API_KEY=<your Gemini API key from https://aistudio.google.com/apikey>
GEMINI_MODEL_ID=gemini-3.1-flash-lite
# GEMINI_VISION_MODEL_ID=gemini-3.1-flash-lite
# GEMINI_THINKING_LEVEL=low            # minimal | low | medium | high

# Usage guards for the free tier
# AGENT_MAX_CALLS_PER_MINUTE=12        # model calls per minute from this backend (0 = off)
# AGENT_MAX_TURNS_PER_SESSION=30       # AI replies per conversation (0 = off)
# AGENT_TURN_TIMEOUT_S=25
# AGENT_VISION_TIMEOUT_S=55

# Local storage (defaults shown)
# DDB_ENDPOINT=http://localhost:8001
# ACCEPTMATCH_TABLE=acceptmatch_demo
# LOCAL_IMAGE_ROOT=.local/images

# Demo sign-in secrets come from `python -m backend.scripts.dev secrets` (.local/dev-secrets.env), not from here.
# Amazon Bedrock instead of Gemini: APP_MODE=bedrock-local, BEDROCK_MODEL_ID, BEDROCK_REGION.
# AgentCore: APP_MODE=agentcore plus your own AGENTCORE_RUNTIME_ARN and AGENTCORE_MODEL_ID.
# See docs/BACKEND.md and docs/AGENTCORE_PUBLIC.md. Never commit provider identifiers or credentials.
